                              "id": "D9PfzZ",
                              "name": "Item",
                              "width": "fill_container",
                              "gap": 12,
                              "children": [
                                {
                                  "type": "ellipse",
                                  "id": "MbWuK",
                                  "layoutPosition": "absolute",
                                  "x": 2,
                                  "y": 10,
                                  "name": "Dot",
                                  "fill": "$surface-accent",
                                  "width": 7,
                                  "height": 7
                                },
                                {
                                  "type": "frame",
                                  "id": "GWp7H",
                                  "name": "sp",
                                  "width": 14,
                                  "height": 1
                                },
                                {
                                  "type": "text",
                                  "id": "SJIHR",
                                  "name": "t",
                                  "fill": "$text-secondary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Teams own a metric, not a backlog of features.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$font-sans",
