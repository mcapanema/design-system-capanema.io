                {
                  "type": "text",
                  "id": "Nymaq",
                  "name": "Description",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "content": "The complete mode map. Every semantic token defines one value per mode at creation — components never know which mode they are in. Light is the base resolution; Dark overrides on the Mode axis. Foundation primitives stay static; three dark surfaces (dark-700/800/900) and three lighter accent steps (accent-200/300/400) were added to Foundation to serve the dark resolutions.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-sans",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
