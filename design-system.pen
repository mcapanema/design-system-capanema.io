                    {
                      "type": "text",
                      "id": "QJxVo",
                      "name": "Body",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Both modes are tuned for long-form case studies and leadership writing. Dark mode avoids pure black and harsh contrast — near-white text on deep slate keeps extended reading sessions comfortable without sacrificing AA legibility.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
