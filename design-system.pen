                      "width": "fill_container",
                      "content": "One system, two renderings",
                      "fontFamily": "$font-sans",
                      "fontSize": 19,
                      "fontWeight": "600",
                      "letterSpacing": -0.25
                    },
                    {
                      "type": "text",
                      "id": "J8GFmk",
                      "name": "Body",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Light and Dark are the same design resolved through different token values. Layout, spacing, type scale and hierarchy never change between modes — only the resolution of semantic color. Hierarchy comes from size and weight, never from color.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 14.5,
                      "fontWeight": "normal"
                    }
