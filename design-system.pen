                      "fill": "$text-on-dark",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "/* tokens.css — one variable set, two resolutions */\n:root {\n  --surface-primary: #FFFFFF;\n  --text-primary:    #0F172A;\n  --link:            #2563EB;\n}\n\n[data-theme=\"dark\"] {\n  --surface-primary: #0B1020;\n  --text-primary:    #F8FAFC;\n  --link:            #60A5FA;\n}\n\n/* Follow the system unless the visitor chose */\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme]) {\n    --surface-primary: #0B1020;\n    --text-primary:    #F8FAFC;\n    --link:            #60A5FA;\n  }\n}\n\n/* components — no theme awareness, ever */\n.card { background: var(--surface-elevated); }",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
