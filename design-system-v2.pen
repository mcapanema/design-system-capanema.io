                      "children": [
                        {
                          "type": "text",
                          "id": "wiVWl",
                          "name": "P1",
                          "fill": "$text-prose",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "When I joined, scheduling across the network ran on a patchwork of spreadsheets and a decade-old system nobody fully understood. Every hospital did it differently, and the cost showed up as idle operating rooms and patients waiting weeks for routine procedures.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "x1RrBn",
                          "name": "H2a",
                          "fill": "$text-primary",
                          "content": "What we changed",
                          "lineHeight": 1.3,
                          "fontFamily": "Inter",
                          "fontSize": 24,
                          "fontWeight": "600",
                          "letterSpacing": -0.3
                        },
                        {
                          "type": "text",
                          "id": "UunPa",
                          "name": "P2",
                          "fill": "$text-prose",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "We rebuilt scheduling as a real-time optimization engine, rolling it out hospital by hospital so the network never lost a day. The hard part was never the solver — it was earning the trust of the people whose work it changed.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "id": "a7m9u",
                          "type": "ref",
                          "ref": "oV5N6",
                          "name": "Pull",
                          "width": "fill_container",
                          "descendants": {
                            "giEAq": {
                              "content": "The algorithm was the easy part. The two years of trust-building around it were the actual work."
                            }
                          }
                        },
                        {
                          "type": "text",
                          "id": "GGsZK",
                          "name": "P3",
                          "fill": "$text-prose",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "By the end, utilization was up across every site and wait times had fallen by nearly half. But the outcome I am proudest of is that the team running it today never needs to call me.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "id": "PTYLz",
                          "type": "ref",
                          "ref": "WlpMe",
                          "name": "Result",
                          "width": "fill_container",
                          "fill": "$status-success-surface",
                          "descendants": {
                            "ZYRK5": {
                              "icon": "circle-check",
                              "fill": "$status-success-fg"
                            },
                            "VEi4E": {
                              "content": "Outcome"
                            },
                            "srHuJ": {
                              "content": "3.2M patients served annually, 42% lower average wait time, and a platform the network now owns end to end."
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
