                    {
                      "type": "text",
                      "id": "M2B6cD",
                      "name": "P1",
                      "fill": "$text-prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Case studies and essays read on a constrained measure of roughly sixty-six characters with generous leading. The line length keeps the eye from fatiguing across long passages, and the softened body color reduces glare against white while staying comfortably above the AA contrast floor.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DA0eQ",
                      "name": "P2",
                      "fill": "$text-prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "This is the reading experience of a premium publication: unhurried, precise, and built for sustained attention rather than a quick scan. Headlines lead with outcomes; the prose explains how the outcome was achieved.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
