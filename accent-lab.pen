            {
              "type": "text",
              "id": "l7xPba",
              "name": "Sub",
              "fill": "#475569",
              "textGrowth": "fixed-width",
              "width": 860,
              "content": "Each finalist rendered as nav → hero → trust strip → two case-study cards → footer, in Light and Dark. Disciplined distribution on all (card categories neutral; accent on hero eyebrow, primary CTA, links, active nav; metrics in ink) so color is the only variable — except Data-Semantic, which inverts that by design (slate actions, green metric as the only chroma).",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
